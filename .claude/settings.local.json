{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash", "Read", "Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(Remove-Item:*)",
      "Bash(del:*)",
      "Bash(rmdir:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
